{
  "name": "iobroker.webhook",
  "version": "0.2.4",
  "description": "Receives HTTP webhooks and stores the transmitted data as ioBroker states",
  "author": {
    "name": "MrErdnuss",
    "email": "thomas.dick@inkblot.de"
  },
  "homepage": "https://github.com/MrErdnuss/ioBroker.iobroker-webhook",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "webhook",
    "http",
    "Smart Home",
    "home automation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MrErdnuss/ioBroker.iobroker-webhook.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.1",
    "@iobroker/types": "^8.0.0-alpha.8-20261016-fbcb96b80",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3"
  },
  "main": "build/main.js",
  "files": [
    "admin/",
    "build/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint -c eslint.config.mjs",
    "test:package": "mocha test/packageFiles --exit",
    "test:unit": "mocha test/unitWebhook test/unitRoles --exit",
    "test:integration": "mocha test/integrationAdapter --exit",
    "test": "npm run test:package && npm run test:unit",
    "translate": "translate-adapter -b admin/i18n/en.json",
    "release": "release-script",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "update-packages": "npx -y npm-check-updates --upgrade"
  },
  "bugs": {
    "url": "https://github.com/MrErdnuss/ioBroker.iobroker-webhook/issues"
  },
  "readmeFilename": "README.md"
}
